# Copy to .env and fill in. Required settings have no default.

# Required. Orgs to audit: name=url pairs, any number, comma separated.
OKTA_ORGS=prod=https://your-org.okta.com
# Required per org: read-only API token. Name is OKTA_AUDITOR_<NAME>_API_TOKEN (upper case).
OKTA_AUDITOR_PROD_API_TOKEN=

# Sign-in. AUTH_MODE is "oidc" (default) or "none" (no sign-in; local use only).
AUTH_MODE=oidc
# Required when AUTH_MODE=oidc:
FLASK_SECRET_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# At least one is required when AUTH_MODE=oidc (comma separated):
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_DOMAINS=
# Optional. Public URL; an https URL marks the session cookie Secure. Default: empty.
APP_BASE_URL=

# Optional server settings.
# HOST defaults to 127.0.0.1 (the container sets 0.0.0.0). PORT defaults to 8080.
HOST=
PORT=

# Optional tuning (defaults shown).
OKTA_PAGE_LIMIT=1000
DEFAULT_CHANGE_LIMIT=500
MAX_CHANGE_LIMIT=5000
MAX_RAW_COLLAPSE_ROWS=10000
MAX_RAW_SCAN_EVENTS=30000
REQUEST_TIMEOUT_SECONDS=30
MAX_HOURS=2160

# Optional noise rules (comma separated, case-insensitive except the exact list).
SYSTEM_ACTOR_ALTERNATE_IDS=system@okta.com
AUTOMATION_UA_SUBSTRINGS=azuqua,okta-,oktasync,workflows,okta integration,python-requests,go-resty,go-http-client,curl/,wget/,postmanruntime,apache-httpclient,java/,okhttp,node-fetch,axios
SERVER_SIDE_AUTOMATION_UA_EXACT=Azuqua
